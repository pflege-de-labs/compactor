_compactor_checkpoint() {
    local line state
    _arguments -S -C -s\
 \
        "1: :->cmds" \
        "*::arg:->args"
    case "$state" in
        cmds)
            _values "compactor_checkpoint command" \
                "show[Print a checkpoint's current state as JSON.]" \
