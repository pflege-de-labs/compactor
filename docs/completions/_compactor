        "--week=[Week checkpoint to target (YYYY-Www).]:week checkpoint to target (yyyy-www).:" \
        "--month=[Month checkpoint to target (YYYY-MM).]:month checkpoint to target (yyyy-mm).:"
}

_compactor_checkpoint_reset() {
    _arguments -S -C -s\
        "--day=[Day checkpoint to target (YYYY-MM-DD).]:day checkpoint to target (yyyy-mm-dd).:" \
        "--week=[Week checkpoint to target (YYYY-Www).]:week checkpoint to target (yyyy-www).:" \
        "--month=[Month checkpoint to target (YYYY-MM).]:month checkpoint to target (yyyy-mm).:" \
