_compactor() {
    local line state
    _arguments -S -C -s\
        '(-h --help)'{-h,--help}"[Show context-sensitive help.]" \
        "--config=[Path to YAML config file (default: XDG config dir).]:path to yaml config file (default: xdg config dir).:" \
        "--s3-endpoint=[S3 endpoint (empty = AWS default; set for MinIO, e.g. http://localhost:9000).]:s3 endpoint (empty = aws default; set for minio, e.g. http://localhost:9000).:" \
        "--s3-region=[AWS region.]:aws region.:" \
        "--s3-bucket=[Bucket name.]:bucket name.:" \
        "--s3-use-path-style[Use path-style S3 addressing (most MinIO deployments).]" \
        "--paths-source-prefix=[Base prefix under which year/month/day raw events live.]:base prefix under which year/month/day raw events live.:" \
        "--paths-rollup-prefix=[Rollup key prefix.]:rollup key prefix.:" \
        "--paths-checkpoint-prefix=[Checkpoint key prefix.]:checkpoint key prefix.:" \
        "--encryption-scheme=[Rollup output scheme.]:rollup output scheme.:(none age)" \
        "--encryption-age-recipients=[age1... recipient public keys.]:age1... recipient public keys.:" \
        "--encryption-age-identity-file=[Path to age identity file (required for decrypt/materialize).]:path to age identity file (required for decrypt/materialize).:" \
        "--rollup-straggler-days=[Also re-check N prior days on every hourly run.]:also re-check n prior days on every hourly run.:" \
        "--rollup-week-start=[Reserved; ISO 8601 (Monday-start) weeks are used today.]:reserved; iso 8601 (monday-start) weeks are used today.:" \
        "--materialize-cache-ttl=[Materialized scratch file TTL, for the expiry sweep.]:materialized scratch file ttl, for the expiry sweep.:" \
        "--listen-nats-url=[NATS server URL.]:nats server url.:" \
        "--listen-nats-stream=[JetStream stream MinIO's NATS notification target publishes to.]:jetstream stream minio's nats notification target publishes to.:" \
        "--listen-nats-subject=[Filter subject within the stream.]:filter subject within the stream.:" \
        "--listen-nats-consumer=[Durable JetStream consumer name.]:durable jetstream consumer name.:" \
        "--listen-http-addr=[Address to serve /healthz and /readyz on.]:address to serve /healthz and /readyz on.:" \
        "--listen-debounce=[Coalesce a burst of notifications for one day into a single reconcile.]:coalesce a burst of notifications for one day into a single reconcile.:" \
        "--logging-level=[Log level.]:log level.:(debug info warn error)" \
        "--logging-format=[Log format.]:log format.:(text json)" \
        "--version[Print version and exit.]" \
        "1: :->cmds" \
        "*::arg:->args"
    case "$state" in
        cmds)
            _values "compactor command" \
                "rollup[Roll up source events into day/week/month JSONL.]" \
                "materialize[Decrypt a rollup object into a local scratch file for DuckDB.]" \
                "checkpoint[Inspect or reset checkpoint state.]" \
                "listen[Run as a long-lived event-driven daemon (NATS-triggered rollups, health probes).]" \
                "man[Generate the man page.]" \
                "completions[Generate a shell completion script.]"
            ;;
        args)
            case "$line[1]" in
                rollup)
                    _compactor_rollup;;
                materialize)
                    _compactor_materialize;;
                checkpoint)
                    _compactor_checkpoint;;
                listen)
                    _compactor_listen;;
                man)
                    _compactor_man;;
                completions)
                    _compactor_completions;;
            esac
            ;;
    esac

}

