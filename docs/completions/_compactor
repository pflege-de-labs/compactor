    _arguments -S -C -s\
        "--out=[Scratch directory to write the decrypted file into (default: XDG cache dir).]:scratch directory to write the decrypted file into (default: xdg cache dir).:" \
        "--keep[Skip sweeping expired scratch files from a previous run before materializing.]" \
        "1:key:"
}

