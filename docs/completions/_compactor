#compdef compactor
compdef _compactor compactor
# zsh completion for compactor
# generated by king (https://github.com/miekg/king) for kong

_compactor_rollup_hourly() {
    _arguments -S -C -s\
        "--day=[Day to process (YYYY-MM-DD); default: today plus configured straggler days.]:day to process (yyyy-mm-dd); default: today plus configured straggler days.:"
}

_compactor_rollup_promote_week() {
    _arguments -S -C -s\
        "--week=[ISO week to promote (YYYY-Www); default: current ISO week.]:iso week to promote (yyyy-www); default: current iso week.:"
}

_compactor_rollup_promote_month() {
    _arguments -S -C -s\
        "--month=[Month to promote (YYYY-MM); default: current month.]:month to promote (yyyy-mm); default: current month.:"
}

_compactor_rollup() {
    local line state
    _arguments -S -C -s\
 \
        "1: :->cmds" \
        "*::arg:->args"
    case "$state" in
        cmds)
            _values "compactor_rollup command" \
                "hourly[Incremental day rollup (current day + configured stragglers).]" \
                "promote-week[Rebuild a week rollup from its day rollups.]" \
                "promote-month[Rebuild a month rollup from its week rollups.]"
            ;;
        args)
            case "$line[1]" in
                hourly)
                    _compactor_rollup_hourly;;
                promote-week)
                    _compactor_rollup_promote_week;;
                promote-month)
                    _compactor_rollup_promote_month;;
            esac
            ;;
    esac

}

